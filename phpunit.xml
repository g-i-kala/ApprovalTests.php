<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.2/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" testdox="true" cacheDirectory=".phpunit.cache" executionOrder="depends,defects" beStrictAboutOutputDuringTests="true" displayDetailsOnPhpunitDeprecations="true" failOnPhpunitDeprecation="true" failOnRisky="true" failOnWarning="true">
  <testsuites>
    <testsuite name="approval">
      <directory suffix=".php">tests/</directory>
    </testsuite>
  </testsuites>
  <coverage>
    <report>
      <html outputDirectory="test-reports"/>
      <text outputFile="php://stdout"/>
      <clover outputFile="test-reports/coverage.xml"/>
    </report>
  </coverage>
  <source restrictNotices="true" restrictWarnings="true" ignoreIndirectDeprecations="true">
    <include>
      <directory suffix=".php">src</directory>
    </include>
  </source>
</phpunit>
